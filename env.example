SERVER_PORT=8080
PROFILE=development

# File logging (Spring Boot/Logback): path file log.
LOG_FILE=logs/kepegawaian.log
# Rotasi: ukuran maks per file dan total disk (opsional, ada default di application.yml).
LOG_MAX_FILE_SIZE=50MB
LOG_TOTAL_SIZE_CAP=500MB

FLYWAY_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_SCHEMA=kepegawaian_dev
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10
DDL_AUTO=none

APPWRITE_ENDPOINT=http://localhost:82/v1
APPWRITE_PROJECT_ID=CHANGE_ME
APPWRITE_API_KEY=CHANGE_ME

PROTECTED_DELETE_KTP=1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CACHE_TTL=600000

PENGGAJIAN_URL=http://localhost:81
LAPORAN_KEPEGAWAIAN_URL=http://localhost:82

JENIS_CUTI_TAHUNAN=1
JENIS_CUTI_BESAR=2

JABATAN_MANAGER_SDM=48
JABATAN_SUPERVISOR_SDM=49